# Copy to .env.local (gitignored). Expo inlines EXPO_PUBLIC_* at build time.

# Override the API base URL (defaults to the deployed Heroku API in src/config/env.ts).
# On a physical device use your machine's LAN address, not localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api/v1

# Google OAuth *web* client ID — the native SDK uses it to mint the ID token
# sent to POST /auth/google. See docs/GOOGLE_SIGNIN.md.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
