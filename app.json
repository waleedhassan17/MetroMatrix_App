{
  "expo": {
    "name": "MetroMatrix",
    "slug": "metromatrix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "metromatrix",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "android": {
      "package": "com.metromatrix.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#091118"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.metromatrix.app",
      "supportsTablet": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-mark.png",
          "imageWidth": 104,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MetroMatrix uses your location to pin your business address on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MetroMatrix needs your photos to upload documents, health records and pictures.",
          "cameraPermission": "MetroMatrix needs the camera to photograph documents and health records."
        }
      ],
      "expo-notifications",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.TODO-ios-client-id"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "MetroMatrix uses the camera for video consultations with your doctor.",
          "microphonePermission": "MetroMatrix uses the microphone for video consultations with your doctor.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "MetroMatrix uses the microphone for video consultations with your doctor."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "MetroMatrix adds your appointments to your calendar when you ask it to."
        }
      ]
    ]
  }
}
