{
  "expo": {
    "name": "MetroMatrix",
    "slug": "metromatrix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "metromatrix",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "android": {
      "package": "com.metromatrix.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F7F5F1"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.metromatrix.app",
      "supportsTablet": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F1",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0E0E10"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MetroMatrix uses your location to pin your business address on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MetroMatrix needs your photos to upload verification documents and your profile picture.",
          "cameraPermission": "MetroMatrix needs the camera to photograph verification documents."
        }
      ],
      "expo-notifications",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.TODO-ios-client-id"
        }
      ]
    ]
  }
}
