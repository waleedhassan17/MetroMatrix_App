{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.10:3000/api/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging-api.metromatrix.example/api/v1",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@metromatrix.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.metromatrix.example/api/v1",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "support@metromatrix.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
